# Ignore everything by default. Explicitly allow only the files we want
# to keep under version control, similar to the reference repo.
/*
/**/

# Root-level tracked files.
!/.gitignore
!/.tmux.conf
!/.zprofile
!/.zshenv
!/.zshrc
!/README.md

# Shared shell fragments.
!/zsh/
/zsh/*
!/zsh/env.zsh
!/zsh/aliases.zsh
!/zsh/plugins.zsh

# Placeholder directory for future tmux fragments.
!/tmux/
/tmux/*
!/tmux/.gitkeep

# Managed app config.
!/claude/
/claude/*
!/claude/settings.json

!/cursor/
/cursor/*
!/cursor/mcp.json
!/cursor/README.md

!/codex/
/codex/*
!/codex/skills/
!/codex/skills/**
/codex/skills/.system
!/codex/.gitignore

# Scripts.
!/scripts/
/scripts/*
!/scripts/bootstrap.sh
!/scripts/check.sh

# Read-only reference repo.
!/references/
!/references/theniceboy-config/
!/references/theniceboy-config/**

# Generic junk inside allowed paths.
**/.DS_Store
**/*.bak
