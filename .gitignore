# Ignore everything by default. Explicitly allow only the files we want
# to keep under version control, similar to the reference repo.
/*
/**/

# Root-level tracked files.
!/.gitignore
!/.tmux.conf
!/.zprofile
!/.zshenv
!/.zshrc
!/README.md

# Shared shell fragments.
!/zsh/
/zsh/*
!/zsh/env.zsh
!/zsh/aliases.zsh
!/zsh/plugins.zsh
!/zsh/fzf.zsh

# Placeholder directory for future tmux fragments.
!/tmux/
/tmux/*
!/tmux/.gitkeep

# Managed app config.
!/claude/
/claude/*
!/claude/settings.json

!/ghostty/
/ghostty/*
!/ghostty/config

!/yazi/
/yazi/*
!/yazi/yazi.toml
!/yazi/keymap.toml
!/yazi/theme.toml

!/starship/

!/INSTALL.md

!/neovim/
!/neovim/lua/
!/neovim/lua/**

!/cursor/
/cursor/*
!/cursor/mcp.json
!/cursor/README.md

!/agents/
/agents/*
!/agents/.skill-lock.json
!/agents/skills/
!/agents/skills/**

!/codex/
/codex/*
!/codex/config.toml
!/codex/skills
/codex/skills/skills/.system
!/codex/skills/**
/codex/skills/.system

# Scripts.
!/scripts/
/scripts/*
!/scripts/bootstrap.sh
!/scripts/check.sh
!/scripts/test_managed_block.sh
!/scripts/lib
/scripts/lib/*
!/scripts/lib/managed_block.sh
!/scripts/lib/bootstrap_common.sh

# Read-only reference repo.
!/references/
!/references/theniceboy-config/
!/references/theniceboy-config/**

# Generic junk inside allowed paths.
**/.DS_Store
**/*.bak
